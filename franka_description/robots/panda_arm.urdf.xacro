<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:include filename="$(find franka_description)/robots/panda_arm.xacro" />
  <xacro:include filename="$(find franka_description)/robots/panda.ros2_control.xacro" />

  <xacro:arg name="arm_id" default="panda"/>
  <xacro:arg name="robot_ip" default=""/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="load_gripper" default="false"/>

  <xacro:panda_arm safety_distance="0.03"/>
  <xacro:panda_ros2_control arm_id="$(arg arm_id)" robot_ip="$(arg robot_ip)"
                             use_fake_hardware="$(arg use_fake_hardware)"/>
</robot>
